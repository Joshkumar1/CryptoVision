# ═══════════════════════════════════════════════════════════════════════
# CryptoVision AI — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (optional — in-memory by default) ─────────────────────────
MONGODB_URI=mongodb://localhost:27017/cryptovision

# ── JWT Authentication ─────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=7d

# ── Redis (optional — falls back to in-memory cache) ──────────────────
REDIS_URL=

# ═══════════════════════════════════════════════════════════════════════
# DATA PROVIDERS
# Missing API keys = provider disabled (system still runs)
# ═══════════════════════════════════════════════════════════════════════

# ── Market Data: CoinGecko ─────────────────────────────────────────────
# Purpose: Primary market data (price, volume, market cap, dev data)
# Required: No (free tier works without key, paid key improves rate limits)
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
ENABLE_COINGECKO=true

# ── Market Data: CoinMarketCap ─────────────────────────────────────────
# Purpose: Secondary market data for cross-validation
# Required: Yes (key needed for API access)
# Get key: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=
ENABLE_CMC=true

# ── DeFi Fundamentals: DeFiLlama ──────────────────────────────────────
# Purpose: TVL, fees, revenue, token unlocks, treasury, yields, hacks
# Required: No (free public API — no key needed)
ENABLE_DEFILLAMA=true

# ── On-Chain: Alchemy ──────────────────────────────────────────────────
# Purpose: Wallet balances, token holders, transactions, contract data
# Required: Yes (key needed)
# Get key: https://www.alchemy.com/
ALCHEMY_API_KEY=
ENABLE_ONCHAIN=true

# ── On-Chain: QuickNode (future fallback) ──────────────────────────────
QUICKNODE_API_KEY=

# ── Developer Intelligence: GitHub ─────────────────────────────────────
# Purpose: Commit activity, contributors, releases, repo health
# Required: Yes (key needed for adequate rate limits)
# Get key: https://github.com/settings/tokens (classic PAT, public_repo scope)
GITHUB_TOKEN=
ENABLE_GITHUB=true

# ── Exchange Data: Binance ─────────────────────────────────────────────
# Purpose: OHLCV, order book depth, market microstructure
# Required: No (public endpoints work without key)
BINANCE_API_KEY=
BINANCE_API_SECRET=
ENABLE_BINANCE=true

# ── News: CryptoPanic ─────────────────────────────────────────────────
# Purpose: Primary crypto news intelligence
# Required: Yes (key needed)
# Get key: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=
ENABLE_NEWS=true

# ── News: NewsData.io (fallback) ──────────────────────────────────────
# Purpose: Fallback news source when CryptoPanic is unavailable
# Required: No (optional fallback)
# Get key: https://newsdata.io/
NEWSDATA_API_KEY=

# ── Security: GoPlus ──────────────────────────────────────────────────
# Purpose: Token smart contract security analysis
# Required: Yes (key needed)
# Get key: https://gopluslabs.io/
GOPLUS_API_KEY=
ENABLE_SECURITY=true

# ── Sentiment: Alternative.me ─────────────────────────────────────────
# Purpose: Fear & Greed Index (contextual only — NOT used for scoring)
# Required: No (free public API — always available)

# ═══════════════════════════════════════════════════════════════════════
# AI PROVIDERS
# ═══════════════════════════════════════════════════════════════════════

# ── Google Gemini (for AI Research Analyst) ────────────────────────────
GEMINI_API_KEY=

# ── OpenAI (optional alternative) ─────────────────────────────────────
OPENAI_API_KEY=

# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL PROFESSIONAL PROVIDERS (premium tiers)
# ═══════════════════════════════════════════════════════════════════════

# ── Messari ────────────────────────────────────────────────────────────
MESSARI_API_KEY=
ENABLE_MESSARI=false

# ── Kaiko ──────────────────────────────────────────────────────────────
KAIKO_API_KEY=
ENABLE_KAIKO=false

# ── Coin Metrics ──────────────────────────────────────────────────────
COINMETRICS_API_KEY=
ENABLE_COINMETRICS=false

# ═══════════════════════════════════════════════════════════════════════
# FRONTEND
# ═══════════════════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:4000

